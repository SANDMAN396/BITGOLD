#!/sbin/openrc-run

# backward compatibility for existing gentoo layout
#
if [ -d "/var/lib/bitgold/.bitgold" ]; then
	BITGOLDD_DEFAULT_DATADIR="/var/lib/bitgold/.bitgold"
else
	BITGOLDD_DEFAULT_DATADIR="/var/lib/bitgoldd"
fi

BITGOLDD_CONFIGFILE=${BITGOLDD_CONFIGFILE:-/etc/bitgold/bitgold.conf}
BITGOLDD_PIDDIR=${BITGOLDD_PIDDIR:-/var/run/bitgoldd}
BITGOLDD_PIDFILE=${BITGOLDD_PIDFILE:-${BITGOLDD_PIDDIR}/bitgoldd.pid}
BITGOLDD_DATADIR=${BITGOLDD_DATADIR:-${BITGOLDD_DEFAULT_DATADIR}}
BITGOLDD_USER=${BITGOLDD_USER:-${BITGOLD_USER:-bitgold}}
BITGOLDD_GROUP=${BITGOLDD_GROUP:-bitgold}
BITGOLDD_BIN=${BITGOLDD_BIN:-/usr/bin/bitgoldd}
BITGOLDD_NICE=${BITGOLDD_NICE:-${NICELEVEL:-0}}
BITGOLDD_OPTS="${BITGOLDD_OPTS:-${BITGOLD_OPTS}}"

name="BitGold Core Daemon"
description="BitGold cryptocurrency P2P network daemon"

command="${BITGOLDD_BIN}"
command_args="-pid=\"${BITGOLDD_PIDFILE}\" \
		-conf=\"${BITGOLDD_CONFIGFILE}\" \
		-datadir=\"${BITGOLDD_DATADIR}\" \
		-daemon \
		${BITGOLDD_OPTS}"

required_files="${BITGOLDD_CONFIGFILE}"
start_stop_daemon_args="-u ${BITGOLDD_USER} \
			-g ${BITGOLDD_GROUP} \
			-N ${BITGOLDD_NICE} -w 2000"
pidfile="${BITGOLDD_PIDFILE}"

# The retry schedule to use when stopping the daemon. Could be either
# a timeout in seconds or multiple signal/timeout pairs (like
# "SIGKILL/180 SIGTERM/300")
retry="${BITGOLDD_SIGTERM_TIMEOUT}"

depend() {
	need localmount net
}

# verify
# 1) that the datadir exists and is writable (or create it)
# 2) that a directory for the pid exists and is writable
# 3) ownership and permissions on the config file
start_pre() {
	checkpath \
	-d \
	--mode 0750 \
	--owner "${BITGOLDD_USER}:${BITGOLDD_GROUP}" \
	"${BITGOLDD_DATADIR}"

	checkpath \
	-d \
	--mode 0755 \
	--owner "${BITGOLDD_USER}:${BITGOLDD_GROUP}" \
	"${BITGOLDD_PIDDIR}"

	checkpath -f \
	-o "${BITGOLDD_USER}:${BITGOLDD_GROUP}" \
	-m 0660 \
	"${BITGOLDD_CONFIGFILE}"

	checkconfig || return 1
}

checkconfig()
{
	if grep -qs '^rpcuser=' "${BITGOLDD_CONFIGFILE}" && \
		! grep -qs '^rpcpassword=' "${BITGOLDD_CONFIGFILE}" ; then
		eerror ""
		eerror "ERROR: You must set a secure rpcpassword to run bitgoldd."
		eerror "The setting must appear in ${BITGOLDD_CONFIGFILE}"
		eerror ""
		eerror "This password is security critical to securing wallets "
		eerror "and must not be the same as the rpcuser setting."
		eerror "You can generate a suitable random password using the following "
		eerror "command from the shell:"
		eerror ""
		eerror "bash -c 'tr -dc a-zA-Z0-9 < /dev/urandom | head -c32 && echo'"
		eerror ""
		eerror "It is recommended that you also set alertnotify so you are "
		eerror "notified of problems:"
		eerror ""
		eerror "ie: alertnotify=echo %%s | mail -s \"BitGold Alert\"" \
			"admin@foo.com"
		eerror ""
		return 1
	fi
}
